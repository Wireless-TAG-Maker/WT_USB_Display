# Publish only the two source projects, their tools and documentation.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/agent.md
!/firmware/
!/host/
!/scripts/
!/docs/

/firmware/*
!/firmware/.gitignore
!/firmware/CMakeLists.txt
!/firmware/README.md
!/firmware/COPYING.GPL-2.0
!/firmware/dependencies.lock
!/firmware/sdkconfig.defaults
!/firmware/sdkconfig.display
!/firmware/sdkconfig.usb_display
!/firmware/sdkconfig.benchmark
!/firmware/sdkconfig.touch
!/firmware/sdkconfig.latency
!/firmware/main/
/firmware/main/*
!/firmware/main/*.c
!/firmware/main/*.h
!/firmware/main/CMakeLists.txt
!/firmware/main/Kconfig.projbuild
!/firmware/main/idf_component.yml

/host/*
!/host/macos/
/host/macos/*
!/host/macos/README.md
!/host/macos/Package.swift
!/host/macos/Package.resolved
!/host/macos/build.sh
!/host/macos/GLINT-LICENSE
!/host/macos/THIRD_PARTY_NOTICES.md
!/host/macos/Sources/
!/host/macos/Checks/

/scripts/*
!/scripts/build_firmware.sh
!/scripts/check_macos_launch.sh
!/scripts/measure_macos_cpu.py
!/scripts/analyze_benchmark.py
!/scripts/capture_benchmark.py
!/scripts/windows/
/scripts/windows/*
!/scripts/windows/README.md
!/scripts/windows/build.cmd
!/scripts/windows/desktop.py
!/scripts/windows/serve.py
!/scripts/windows/live_sender.py
!/scripts/windows/usb_stream.py
!/scripts/windows/topology.py
!/scripts/windows/virtual_monitor.py
!/scripts/windows/GpuCapture.cpp
!/scripts/windows/P4Desktop.cs
!/scripts/windows/fps/
/scripts/windows/fps/*
!/scripts/windows/fps/Camera.cpp
!/scripts/windows/fps/MotionMeter.cs
!/scripts/windows/fps/RateChart.cs
!/scripts/windows/fps/measure.sh
!/scripts/windows/fps/runmeter.py
!/scripts/windows/fps/sample.py
!/scripts/windows/fps/analyze_camera.py
!/scripts/windows/fps/summarize.py

/docs/*
!/docs/assets/
/docs/assets/*
!/docs/assets/README.md
!/docs/assets/*.svg
!/docs/assets/*.png

# Generated files, local settings and credentials remain private everywhere.
**/.DS_Store
**/._*
**/__pycache__/
**/*.py[cod]
**/.build/
**/build*/
**/managed_components/
**/sdkconfig
**/sdkconfig.old
**/.swiftpm/
**/.vscode/
**/.idea/
**/*.log
**/*.bin
**/*.elf
**/*.map
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
