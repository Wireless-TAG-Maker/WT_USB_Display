<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="530" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource Canvas}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Foreground="{DynamicResource Ink}">
    <ScrollViewer Background="{DynamicResource Canvas}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,22,24,20">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Width="64" Height="64" Background="{DynamicResource Tint}" CornerRadius="16" VerticalAlignment="Center">
                    <Image x:Name="AppIcon" Width="44" Height="44" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ProductTitle" Style="{DynamicResource Heading}" FontSize="24"/>
                    <TextBlock x:Name="Version" Style="{DynamicResource Caption}"/>
                </StackPanel>
            </Grid>
            <Border Style="{DynamicResource Group}" Padding="16,4">
                <StackPanel x:Name="Links"/>
            </Border>
            <TextBlock Margin="2,16,0,0" FontSize="13" Foreground="{DynamicResource Muted}" TextWrapping="Wrap">
                <Run x:Name="CopyrightPrefix"/><Hyperlink x:Name="Company" Foreground="{DynamicResource Accent}"><Run x:Name="CompanyName"/></Hyperlink><Run x:Name="CopyrightSuffix"/>
            </TextBlock>
            <Button x:Name="CloseButton" Style="{DynamicResource Button}" IsCancel="True" IsDefault="True"
                    Margin="0,18,0,0" HorizontalAlignment="Right" MinWidth="76"/>
        </StackPanel>
    </ScrollViewer>
</Window>
