<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource Canvas}"
      TextElement.FontFamily="Segoe UI, Microsoft YaHei UI" TextElement.FontSize="14"
      TextElement.Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid MaxWidth="820" Margin="24,16,24,24">
            <StackPanel>
                <Border Background="{DynamicResource Hero}" CornerRadius="18" Padding="24,20" MinHeight="184">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Signal" Width="8" Height="8" VerticalAlignment="Center"/>
                                <TextBlock Margin="8,0,0,0" Text="{DynamicResource ConnectionLabel}" FontWeight="SemiBold"
                                           FontSize="13" Foreground="{DynamicResource HeroMuted}"/>
                            </StackPanel>
                            <TextBlock x:Name="Status" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource HeroInk}" Margin="0,5,0,0"/>
                            <TextBlock x:Name="Detail" FontSize="14" TextWrapping="Wrap" LineHeight="21"
                                       Foreground="{DynamicResource HeroMuted}" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="Connect" Style="{DynamicResource Button}" Margin="0,0,8,2"
                                        Background="{DynamicResource HeroInk}" Foreground="{DynamicResource HeroInverse}"
                                        BorderBrush="{DynamicResource HeroInk}"/>
                                <Button x:Name="Pause" Style="{DynamicResource Button}" Margin="0,0,0,2"
                                        Background="{DynamicResource HeroControl}" Foreground="{DynamicResource HeroInk}"
                                        BorderBrush="{DynamicResource HeroOutline}"/>
                            </WrapPanel>
                        </StackPanel>
                        <!-- The external panel lights up only after the device confirms presentation. -->
                        <Viewbox x:Name="Diagram" Grid.Column="1" Width="205" Margin="15,0,0,0" VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Canvas Width="236" Height="145">
                                <Canvas.Resources>
                                    <LinearGradientBrush x:Key="Wallpaper" StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#7DDDE9"/><GradientStop Offset=".48" Color="#83A7F2"/>
                                        <GradientStop Offset="1" Color="#9F86DA"/>
                                    </LinearGradientBrush>
                                </Canvas.Resources>
                                <Ellipse Canvas.Left="5" Canvas.Top="126" Width="218" Height="10" Fill="#400C152E"/>
                                <Rectangle Canvas.Left="10" Canvas.Top="12" Width="153" Height="98" RadiusX="7" RadiusY="7"
                                           Stroke="#B4CAF0" StrokeThickness="1.5" Fill="#192940"/>
                                <Canvas Canvas.Left="15" Canvas.Top="17" Width="143" Height="87" ClipToBounds="True">
                                    <Rectangle Width="143" Height="87" Fill="{StaticResource Wallpaper}"/>
                                    <Path Fill="#7792D7" Data="M-4,71 C29,62 34,32 64,25 C96,16 115,34 147,0 L147,93 L-4,93Z"/>
                                    <Path Fill="#B9BEFA" Data="M-4,86 C50,86 39,46 83,40 C122,34 132,23 147,14 L147,93 L-4,93Z"/>
                                    <Path Fill="#6C74BD" Data="M13,93 C66,94 63,58 108,47 C132,42 145,34 154,25 L154,93Z"/>
                                </Canvas>
                                <Path Fill="#7489AD" Stroke="#ABBAD3" StrokeThickness="1"
                                      Data="M10,109 L163,109 176,116 Q176,119 170,119 L2,119 Q-2,119 0,116Z"/>
                                <Path Stroke="#445675" StrokeThickness="2" Data="M72,111 L103,111"/>
                                <Rectangle Canvas.Left="124" Canvas.Top="66" Width="107" Height="70" RadiusX="6" RadiusY="6"
                                           Fill="#24394D" Stroke="#D1DFEF" StrokeThickness="1.7"/>
                                <Canvas x:Name="PanelWallpaper" Canvas.Left="129" Canvas.Top="71" Width="97" Height="60" ClipToBounds="True">
                                    <Rectangle Width="97" Height="60" Fill="{StaticResource Wallpaper}"/>
                                    <Path Fill="#93A9EA" Data="M-3,41 C24,36 35,13 54,12 C75,12 84,23 101,3 L101,65 L-3,65Z"/>
                                    <Path Fill="#D2CCFA" Data="M-3,60 C31,59 40,32 65,28 Q91,24 102,13 L102,65 L-3,65Z"/>
                                    <Path Fill="#8389C9" Data="M12,64 C54,63 53,44 77,39 Q97,34 105,26 L105,65Z"/>
                                </Canvas>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Border>
                <Grid Margin="2,14,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource SettingsTitle}" Style="{DynamicResource Heading}" VerticalAlignment="Center"/>
                    <Button x:Name="More" Grid.Column="1" Style="{DynamicResource Button}" Padding="11,4" MinHeight="32"
                            Foreground="{DynamicResource Muted}" AutomationProperties.Name="{DynamicResource MoreLabel}"
                            AutomationProperties.HelpText="{DynamicResource MoreHint}" ToolTip="{DynamicResource MoreHint}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <UniformGrid Rows="1" Columns="3" Width="16" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse Width="3" Height="3" Fill="{DynamicResource Muted}"/>
                                <Ellipse Width="3" Height="3" Fill="{DynamicResource Muted}"/>
                                <Ellipse Width="3" Height="3" Fill="{DynamicResource Muted}"/>
                            </UniformGrid>
                            <TextBlock Text="{DynamicResource MoreLabel}" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Border Style="{DynamicResource Group}">
                    <StackPanel>
                        <Button x:Name="Arrange" Style="{DynamicResource RowButton}"
                                AutomationProperties.Name="{DynamicResource ArrangeTitle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Style="{DynamicResource IconTile}">
                                    <Path Style="{DynamicResource Glyph}" Data="M1,2 L14,2 14,11 1,11Z M5,14 L11,14 M16,7 L20,7 20,15 14,15 14,13"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource ArrangeTitle}" Style="{DynamicResource RowTitle}"/>
                                    <TextBlock Text="{DynamicResource ArrangeHint}" Style="{DynamicResource Caption}"/>
                                </StackPanel>
                                <Path Grid.Column="2" Data="M1,1 L6,6 1,11" Style="{DynamicResource Glyph}" Stroke="{DynamicResource Muted}" Margin="16,0,6,0"/>
                            </Grid>
                        </Button>
                        <Border Style="{DynamicResource Divider}"/>
                        <Grid Margin="16,11">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Style="{DynamicResource IconTile}">
                                <Path Style="{DynamicResource Glyph}" Data="M1,5 L5,5 M10,5 L19,5 M1,13 L11,13 M16,13 L19,13 M10,5 A2.5,2.5 0 1 1 5,5 A2.5,2.5 0 1 1 10,5 M16,13 A2.5,2.5 0 1 1 11,13 A2.5,2.5 0 1 1 16,13"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource QualityTitle}" Style="{DynamicResource RowTitle}"/>
                                <TextBlock x:Name="QualityHint" Style="{DynamicResource Caption}"/>
                            </StackPanel>
                            <Border Grid.Column="2" VerticalAlignment="Center" Background="{DynamicResource Track}" Padding="3" CornerRadius="9">
                                <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once">
                                    <RadioButton x:Name="Standard" Content="4:2:0" AutomationProperties.Name="{DynamicResource StandardName}"
                                                 ToolTip="{DynamicResource StandardName}" GroupName="Sampling" Style="{DynamicResource Segment}"/>
                                    <RadioButton x:Name="Full" Content="4:4:4" AutomationProperties.Name="{DynamicResource FullName}"
                                                 ToolTip="{DynamicResource FullName}" GroupName="Sampling" Style="{DynamicResource Segment}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{DynamicResource Divider}"/>
                        <CheckBox x:Name="Startup" Style="{DynamicResource Switch}" Margin="16,7,19,7"
                                  AutomationProperties.Name="{DynamicResource StartupTitle}" AutomationProperties.HelpText="{DynamicResource StartupHint}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{DynamicResource IconTile}">
                                    <Path Style="{DynamicResource Glyph}" Data="M10,1 L10,8 M5.5,3.5 A7,7 0 1 0 14.5,3.5"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource StartupTitle}" Style="{DynamicResource RowTitle}"/>
                                    <TextBlock Text="{DynamicResource StartupHint}" Style="{DynamicResource Caption}"/>
                                </StackPanel>
                            </Grid>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Grid>
